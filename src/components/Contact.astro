---
import Icon from "./Icon.astro";
import { contacts } from "../data/site";
---
<section id="zapys" data-rec="R-UX-11" class="zapys">
  <div class="container zapys__grid">
    <div class="zapys__main">
      <h2 class="zapys__title">Записатися можна телефоном або в месенджері</h2>
      <a class="zapys__phone num" href={contacts.phones[0].href}>{contacts.phones[0].label}</a>
      <a class="zapys__phone2 num" href={contacts.phones[1].href}>{contacts.phones[1].label}</a>
      <div class="zapys__msg">
        <a class="zbtn" href={contacts.viber.href}><Icon name="viber" size={22} /><span>Viber</span></a>
        <a class="zbtn" href={contacts.telegram.href} rel="noopener"><Icon name="telegram" size={22} /><span>Telegram</span></a>
      </div>
      <p class="zapys__hint">Viber: {contacts.viber.number}. Telegram: {contacts.telegram.handle}.</p>
    </div>

    <div class="zapys__side">
      <div class="zapys__item">
        <h3 class="zapys__h">Адреса</h3>
        <p>{contacts.address}<br /><span class="zapys__soft">{contacts.addressNote}</span></p>
        <a class="zlink" href={contacts.map} rel="noopener"><Icon name="pin" size={20} />Побудувати маршрут</a>
      </div>
      <div class="zapys__item">
        <h3 class="zapys__h">Години роботи</h3>
        <p>{contacts.hours}</p>
        <p class="zapys__soft">Також онлайн-консультації.</p>
      </div>
      <div class="zapys__item">
        <h3 class="zapys__h">Ми в соцмережах</h3>
        <ul class="zapys__soc" data-rec="SMM-R009" role="list">
          {contacts.socials.map((s) => (
            <li><a class="zlink" href={s.href} rel="noopener"><Icon name={s.icon} size={20} />{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .zapys {
    background: var(--color-primary); color: var(--color-on-primary);
    padding-block: var(--space-3xl);
    --color-focus: var(--color-gold);
  }
  .zapys :global(:focus-visible) { outline-color: var(--color-gold); }
  .zapys__grid { display: grid; gap: var(--space-2xl); grid-template-columns: minmax(0, 1fr); }
  .zapys__main { display: grid; gap: var(--space-md); align-content: start; }
  .zapys__title { color: var(--color-on-primary); max-width: 18ch; margin-bottom: var(--space-md); }
  .zapys__phone {
    font-family: var(--font-display); font-weight: 500; font-size: clamp(1.625rem, 1.2rem + 2.8vw, 3.5rem); line-height: 1.1; white-space: nowrap;
    color: var(--color-gold); text-decoration: none; width: fit-content; max-width: 100%;
    border-bottom: 1px solid transparent; transition: border-color var(--dur-short) var(--ease-out);
  }
  .zapys__phone:hover { border-bottom-color: var(--color-gold); }
  .zapys__phone2 { font-size: 1.3125rem; font-weight: 600; color: var(--color-on-primary); width: fit-content; min-height: 44px; display: inline-flex; align-items: center; }
  .zapys__phone2:hover { color: var(--color-gold); }
  .zapys__msg { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm); max-width: 28rem; margin-top: var(--space-xs); }
  .zbtn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-xs); min-height: 52px;
    border: 1.5px solid var(--color-gold); border-radius: var(--radius);
    color: var(--color-on-primary); font-weight: 600; text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
  }
  .zbtn :global(.icon) { color: var(--color-gold); }
  .zbtn:hover { background: var(--color-primary-deep); }
  @media (prefers-reduced-motion: no-preference) { .zbtn:active { transform: scale(0.98); } }
  .zapys__hint { font-size: var(--text-small); color: var(--color-on-primary); }
  .zapys__side { display: grid; gap: var(--space-xl); align-content: start; }
  .zapys__item { display: grid; gap: var(--space-xs); padding-top: var(--space-md); border-top: 1px solid var(--color-gold); }
  .zapys__h { font-family: var(--font-body); font-weight: 600; font-size: 1rem; color: var(--color-gold); }
  .zapys__soft { color: var(--color-on-primary); font-size: var(--text-small); }
  .zlink {
    display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 44px; width: fit-content;
    color: var(--color-on-primary); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-gold);
  }
  .zlink :global(.icon) { color: var(--color-gold); flex-shrink: 0; }
  .zlink:hover { color: var(--color-gold); }
  .zapys__soc { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; column-gap: var(--space-lg); }
  @media (min-width: 64rem) {
    .zapys { padding-block: 144px; }
    .zapys__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); }
  }
</style>
