---
import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/site.css";
import golos400 from "@fontsource/golos-text/files/golos-text-cyrillic-400-normal.woff2?url";
import piazzolla500 from "@fontsource/piazzolla/files/piazzolla-cyrillic-500-normal.woff2?url";
import golos600 from "@fontsource/golos-text/files/golos-text-cyrillic-600-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
import golosL400 from "@fontsource/golos-text/files/golos-text-latin-400-normal.woff2?url";
import golosL600 from "@fontsource/golos-text/files/golos-text-latin-600-normal.woff2?url";
import piazzollaL500 from "@fontsource/piazzolla/files/piazzolla-latin-500-normal.woff2?url";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="preload" href={golos400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={piazzolla500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={golos600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={golosL400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={golosL600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={piazzollaL500} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
